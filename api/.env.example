# Application Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Supports On-Prem standalone/replica set or MongoDB Atlas)
URI=mongodb://127.0.0.1:27017/node24api

# Initial Admin Seeding Configuration
adminUserPasssword=Admin@12345
ADMIN_EMAIL=admin@gmail.com
HASH_ROUNDS=10

# Security & Authentication (JWT & Refresh Token)
JWT_SECRET=super_secret_jwt_key_please_change_in_production_2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_please_change_in_production_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# Security Policies
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging & Retention (Files older than 30d will be automatically deleted)
LOG_DIR=logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=30d
ENABLE_CONSOLE_LOG=true
